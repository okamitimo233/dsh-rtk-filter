{
  "name": "@rtk-ai/dsh-rtk-filter",
  "version": "0.50.0",
  "private": true,
  "description": "Transparently runs DeepSeek Harness bash commands through RTK, installing and updating its own RTK binary under the DSH cache.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
