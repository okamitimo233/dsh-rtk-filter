{
  "name": "@rtk-ai/dsh-rtk-filter",
  "version": "0.50.0",
  "private": true,
  "description": "Transparently runs DeepSeek Harness bash commands through RTK, installs and updates its own RTK binary, and exposes an RTK status/config section in DSH Settings.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.mjs",
    "smoke": "node scripts/install-smoke.mjs"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
